# Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to source control.

# --- Required for live Foundry spike ---
# Azure AI Project connection string (from Foundry portal > Project > Overview)
AZURE_AI_PROJECT_CONNECTION_STRING=

# Model deployment name for the agent (e.g., "gpt-4o")
AZURE_AI_AGENT_MODEL_DEPLOYMENT=

# --- Authentication ---
# Uses DefaultAzureCredential (Azure CLI, VS Code, managed identity).
# NO API keys or client secrets. Authenticate via:
#   az login
# or for service principals:
#   Set up OIDC federated credential (see docs/01-product-charter.md)

# --- Optional ---
# Override default Azure authority (for sovereign clouds)
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
